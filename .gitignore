# ============================================
# LOGS - Geral
# ============================================
*.log
*.log.*
logs/
log/
*.out
*.err

# ============================================
# SSH - Ignora chaves, mantém config
# ============================================
ssh/**/.ssh/environment*
ssh/**/.ssh/known_hosts*
ssh/**/id_rsa
ssh/**/id_rsa.pub
ssh/**/id_ed25519
ssh/**/id_ed25519.pub
ssh/**/id_dsa
ssh/**/id_dsa.pub
ssh/**/id_ecdsa
ssh/**/id_ecdsa.pub
ssh/**/known_hosts
ssh/**/authorized_keys
ssh/**/*.pem
ssh/**/*.key
ssh/**/*.crt
ssh/**/*.csr
ssh/**/*.p12
ssh/**/*.pfx
ssh/**/private/
ssh/**/keys/
ssh/**/*_key
ssh/**/*_key.pub

# Mantém config SSH
!ssh/**/config
!ssh/**/config.d/
!ssh/**/config.d/*

# ============================================
# XPIPE
# ============================================
xpipe/.xpipe/cache/
xpipe/.xpipe/logs/
xpipe/.xpipe/lock
xpipe/.xpipe/storage/
xpipe/.xpipe/sync_file
xpipe/.xpipe/workspaces.json
xpipe/.xpipe/*.tmp
xpipe/.xpipe/*.bak

# Mantém configurações do XPipe
!xpipe/.xpipe/settings/
!xpipe/.xpipe/settings/*

# ============================================
# NVIM
# ============================================
nvim/.cache/
nvim/.local/
nvim/.config/nvim/plugin/
nvim/.config/nvim/after/
nvim/.config/nvim/lazy-lock.json
nvim/.config/nvim/lazy/
nvim/.config/nvim/session/
nvim/.config/nvim/swap/
nvim/.config/nvim/undo/
nvim/.config/nvim/backup/
nvim/.config/nvim/*.log
nvim/.config/nvim/spell/
*.swp
*.swo
*.swo?

# ============================================
