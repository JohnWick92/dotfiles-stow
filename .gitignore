zsh/.zcompdump*
zsh/.zcache/
zsh/.zsh_sessions/
zsh/.zsh-update
zsh/.zshrc.local
zsh/*.zwc
zsh/.zinit/
zsh/.zplug/
zsh/.antigen/
zsh/*.log

